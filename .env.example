# Replace with a locally generated 64-character hex secret:
# openssl rand -hex 32
LAVALINK_SERVER_PASSWORD=

# Pin this to an immutable image digest for strict reproducibility.
# The official 4-alpine tag is the upstream-documented Java 17+ v4 image.
LAVALINK_IMAGE=ghcr.io/lavalink-devs/lavalink:4-alpine

# Optional: Spotify Web API application credentials enable Spotify search.
# Spotify tracks are metadata only and are matched to audio from configured providers.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
